# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- LLM providers (both free) ---
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local Ollama (no key needed). Default host shown.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Which provider the agent uses: "ollama" | "gemini"
SQLSENTINEL_PROVIDER=ollama

# --- BIRD benchmark ---
# Extracted BIRD dev set (contains dev.json, dev.sql, dev_databases/).
# The folder name pins the release: dev_20240627 = the 2024-06-27 version.
BIRD_DEV_ROOT=data/bird/dev_20240627

# --- Retained QueryMind Postgres path (optional) ---
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_SERVER=
POSTGRES_DATABASE=

# Trained confidence model used by the API. Produced by scripts/analyze.py
# --calib-traces; the service falls back to the raw agreement rate if absent.
CONFIDENCE_MODEL=results/confidence-model.pkl
