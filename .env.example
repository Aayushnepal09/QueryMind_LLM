# Copy to .env and fill in. .env is gitignored - never commit real values.

# --- LLM providers (both free) ---
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local Ollama (no key needed). Default host shown.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Which provider the agent uses: "ollama" | "gemini"
SQLSENTINEL_PROVIDER=ollama

# --- BIRD benchmark ---
# Path to the extracted BIRD dev set (contains dev.json and dev_databases/)
BIRD_DEV_ROOT=data/bird/dev

# --- Retained QueryMind Postgres path (optional) ---
POSTGRES_USERNAME=
POSTGRES_PASSWORD=
POSTGRES_SERVER=
POSTGRES_DATABASE=
